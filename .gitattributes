# Files used inside Linux containers keep LF line endings on every OS.
Dockerfile text eol=lf
*.dockerignore text eol=lf
docker-compose.yml text eol=lf
*.conf text eol=lf
*.sh text eol=lf
# Real SPHEREx test fixtures are binary.
*.fits binary
# Windows scripts need CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf
