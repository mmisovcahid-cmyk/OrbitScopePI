# OrbitScope on a Raspberry Pi 5 (8 GB) - backend settings
# install.sh copies this to /etc/orbitscope/orbitscope.env (mode 640) and fills in the Wi-Fi values.
# Every external service is public: no API keys are needed.

DEBUG=false
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=text
DEFAULT_LOCALE=az

# nginx in front of the backend sets X-Real-IP: needed for the rate limit and for the kiosk
# screen check (only the Pi itself gets the Wi-Fi password for its QR code).
TRUST_PROXY_HEADERS=true
# Many phones on the access point share one demo: per-client limit for expensive requests.
RATE_LIMIT_PER_MINUTE=40
# Set a token so visitors cannot change candidate reviews (install.sh generates one).
REVIEW_TOKEN=

# Raspberry Pi 5: 4 cores. Two background jobs at a time, six parallel IRSA downloads.
MAX_CONCURRENT_JOBS=2
SPHEREX_DOWNLOAD_CONCURRENCY=6

# Data on the SD card (64 GB): cutout cache capped at 6 GB, oldest cutouts are pruned first.
SPHEREX_CACHE_DIR=/var/lib/orbitscope/cache/spherex
SPHEREX_CACHE_MAX_MB=6000
OFFLINE_CACHE_DIR=/var/lib/orbitscope/cache/offline
ORBITSCOPE_DB_PATH=/var/lib/orbitscope/db/orbitscope.db

# Download the five challenge targets at startup when the internet is reachable (cheap when cached).
PREWARM_ON_STARTUP=true

# Kiosk QR codes (written by install.sh / orbitscope-net)
PUBLIC_URL=http://10.42.0.1
WIFI_AP_SSID=OrbitScope
WIFI_AP_PASSWORD=

# Keep numpy/scipy from starting 4 threads per request on top of the job concurrency.
OMP_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
