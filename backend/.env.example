# OrbitScope Backend Configuration
# Copy this file to .env and customize. Every external service is public: no API keys are needed.

# Application
APP_NAME=OrbitScope
APP_VERSION=1.0.0
# true = uvicorn auto-reload for development. Use false on a public server.
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Public deployment
# Expensive requests (blink, photometry, detection, catalog) per client per minute; 0 = off
RATE_LIMIT_PER_MINUTE=60
# Only behind the bundled nginx proxy (docker compose): read the client IP from X-Real-IP
TRUST_PROXY_HEADERS=false
# Only the team may review candidates when this is set (header X-Review-Token)
REVIEW_TOKEN=
# Download the five challenge targets' data in the background at startup
PREWARM_ON_STARTUP=false

# SPHEREx cutout cache and candidate database
# SPHEREX_CACHE_DIR=cache/spherex
SPHEREX_CACHE_MAX_MB=2000
# ORBITSCOPE_DB_PATH=data/orbitscope.db
# Offline snapshots of JPL / Planet X / name-resolver answers (default: <cache>/../offline)
# OFFLINE_CACHE_DIR=

# Load: parallel IRSA downloads and background jobs (Raspberry Pi profile: 6 and 2)
SPHEREX_DOWNLOAD_CONCURRENCY=10
MAX_CONCURRENT_JOBS=3

# Raspberry Pi kiosk QR codes (deploy/pi/install.sh writes these to /etc/orbitscope/orbitscope.env)
PUBLIC_URL=
WIFI_AP_SSID=
WIFI_AP_PASSWORD=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# CORS (JSON array of origins). Any localhost port is always allowed for development.
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# Default locale
DEFAULT_LOCALE=en
