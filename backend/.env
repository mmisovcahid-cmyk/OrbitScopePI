# OrbitScope Backend Configuration
# Copy this file to .env and customize

# Application
APP_NAME=OrbitScope
APP_VERSION=1.0.0
DEBUG=true
DEMO_MODE=true

# Server
HOST=0.0.0.0
PORT=8000

# NASA/JPL API Endpoints
JPL_SBDB_URL=https://ssd-api.jpl.nasa.gov/sbdb.api
JPL_HORIZONS_URL=https://ssd.jpl.nasa.gov/api/horizons.api
IRSA_TAP_URL=https://irsa.ipac.caltech.edu/TAP/sync

# Optional API Keys (some NASA APIs require keys for higher rate limits)
NASA_API_KEY=DEMO_KEY

# Cache
CACHE_TTL_SECONDS=300
CACHE_MAX_SIZE=1000

# Pipeline
MAX_PIPELINE_WORKERS=4
DEFAULT_DETECTION_SIGMA=3.0
DEFAULT_MATCH_RADIUS_ARCSEC=5.0

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# CORS (JSON array or origins)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]

# Default locale
DEFAULT_LOCALE=en
